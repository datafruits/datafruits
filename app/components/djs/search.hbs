<SimpleMultiSelect
  @options={{this.badges}}
  @selected={{this.selectedBadges}}
  @placeholder={{t "djs.filter"}}
  @onChange={{this.changeBadges}}
>
  <:option as |badge|>
    <img class="w-8 inline mr-2" src={{badge.img}} alt={{badge.name}}/>
    {{badge.name}}
  </:option>
  <:selected as |badge|>
    <img class="w-8 inline mr-2" src={{badge.img}} alt={{badge.name}}/>
    {{badge.name}}
  </:selected>
</SimpleMultiSelect>
