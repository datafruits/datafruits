<div {{did-insert this.didInsert}} class="border-solid border-4 border-df-green">
  <div class="absolute flex justify-end">
    <button
      id="camera--trigger"
      class="cool-button z-10 opacity-40 hover:opacity-100"
      type="button"
      {{on "click" this.cameraAction}}
    >
      {{format-emoji-html "camera"}}
    </button>
    <button
      id="camera--retry"
      class="cool-button z-10 opacity-40 hover:opacity-100"
      type="button"
      {{on "click" this.reloadCamera}}
    >
      {{format-emoji-html "heavy_multiplication_x"}}
    </button>
    <button
      id="camera--send"
      class="cool-button z-10 opacity-40 hover:opacity-100"
      type="button"
      {{on "click" this.sendCamera}}
    >
      {{format-emoji-html "heavy_check_mark"}}
    </button>
  </div>
  <canvas id="camera--canvas" width="0" height="0"></canvas>
  <video id="camera--view" autoplay playsinline></video>
</div>