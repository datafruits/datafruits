<section ...attributes>
  <label class="block text-sm font-bold mb-2 text-df-yellow">{{t "labels.tags"}}</label>
  {{#if this.error}}
    <div class="error">
      {{this.error}}
    </div>
  {{/if}}
  <SimpleMultiSelect
    @options={{this.labels}}
    @selected={{@changeset.labels}}
    @search={{this.searchLabels}}
    @onChange={{this.setSelectedLabels}}
    @onCreate={{this.createTag}}
    @showCreateWhen={{this.hideCreateOptionOnSameName}}
  >
    <:option as |label|>
      {{label.name}}
    </:option>
    <:selected as |label|>
      {{label.name}}
    </:selected>
  </SimpleMultiSelect>
</section>
