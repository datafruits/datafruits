<div class="w-full mt-1" title={{t "xp_progress_meter.tooltip" count=this.xpNeededForNextLevel}}>
  <div
    class="w-full h-2 bg-gray-400 overflow-hidden rounded"
    role="progressbar"
    aria-valuenow={{this.progress}}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-label={{t "xp_progress_meter.aria_label"}}
  >
    <div class="classic:bg-df-green h-full" style={{html-safe-string (concat "width: " this.progress "%; transition: width 0.8s ease-in-out;")}}></div>
  </div>
</div>
